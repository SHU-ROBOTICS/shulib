{
    // The team's buttons: Terminal -> Run Task -> one of these. "Open the route builder" opens this folder's route
    // builder in the browser, where Send to robot is one button (tools/route_builder.py; the terminal keeps it running,
    // Ctrl+C stops it). The two "Upload routes" build the Auton Tester for that robot, upload it to slot 2 and say plainly
    // whether it worked (tools/upload_auton.py). Plug the BRAIN in by USB.
    // (The PROS extension's own Build & Upload builds the default program, not the Auton Tester.)
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open the route builder",
            "type": "shell",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["tools/route_builder.py"],
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Upload routes to robot one",
            "type": "shell",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["tools/upload_auton.py", "one"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Upload routes to robot two",
            "type": "shell",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["tools/upload_auton.py", "two"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ]
}
